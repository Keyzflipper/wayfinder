{
  "name": "wayfinder-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:schema:local": "wrangler d1 execute wayfinder-db --local --file=./src/db/schema.sql",
    "db:schema:remote": "wrangler d1 execute wayfinder-db --remote --file=./src/db/schema.sql",
    "test:identify": "bash scripts/test-identify.sh"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "unpdf": "^0.11.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260310.1": true,
    "workerd@1.20260828.1": true
  }
}
