{
  "name": "wayfinder-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:schema:local": "wrangler d1 execute wayfinder-db --local --file=./src/db/schema.sql",
    "db:schema:remote": "wrangler d1 execute wayfinder-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "unpdf": "^0.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=18"
  }
}
